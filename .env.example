# Copy this file to `.env` and set your own values.
# `.env` is gitignored — put real credentials there, never here.

MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=change-me-db-user
MYSQL_ROOT_PASSWORD=change-me-db-root

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-admin
WORDPRESS_ADMIN_EMAIL=admin@example.com
